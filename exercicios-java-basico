   3. Escreva um código que receba a base e a alturade um retângulo, calcule sua área e exiba na tela
        fórmula: área=base X altura

  import java.util.Scanner;

public class Main {

    public static void main(String []args) {

        var scanner = new Scanner(System.in);
        System.out.println("Informe a base do retângulo: ");
        var value1 = scanner.nextDouble();

        System.out.println("Informe a altura do retângulo: ");
        var value2 = scanner.nextDouble();

        //formula do retângulo
        var formula = value1 * value2;

        System.out.printf("A área do retângulo é %s\n", formula);


    }
}

