   2. Escreva um código que receba o tamanho do lado de um quadrado, calcule sua área e exiba na tela
        fórmula: área=lado X lado

    import java.util.Scanner;

public class Main {

    public static void main(String []args) {

        var scanner = new Scanner(System.in);
        System.out.println("Informe o lado do quadrado: ");
        var value1 = scanner.nextDouble();

        //formula da área do quadrado
        var formula = Math.pow(value1, 2);

        System.out.printf("A área do quadrado é %s\n", formula);


    }
}

