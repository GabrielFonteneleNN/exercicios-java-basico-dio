    1.Escreva um código onde o usuário entra com um número e seja gerada a tabuada de 1 até 10 desse número;


import java.util.Scanner;

public class Main {

    public static void main(String[] args) {

        //1. Escreva um código onde o usuário entra com um número e seja gerada a tabuada de 1 até 10 desse número;

        var scanner = new Scanner(System.in);
        System.out.println("Digite o número que você quer a tabuada: ");
        var number = scanner.nextInt();

        System.out.println("======================================================");
        System.out.printf("                 Tabuada do %s               \n", number);
        System.out.println("======================================================");

        for (var j = 1; j <= 10; j++) {
            var resultTabuada = number * j;
            System.out.printf("%s x %s = %s\n",number, j, resultTabuada);
        }

    }
}

